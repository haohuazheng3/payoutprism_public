# Copy to .env.local and fill in. Never commit real values.

# Site: canonical URL, and whether search engines may index this deployment
NEXT_PUBLIC_SITE_URL=http://localhost:3000
SITE_INDEXABLE=0

# Database (Neon / any Postgres). Pooled for the app, direct for migrations.
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# Owner back office (/admin): password, and a 32+ character secret that signs the session cookie
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=
# Optional: marks the owner's own visits in analytics
OWNER_ANALYTICS_EMAIL=

# Mail worker (owner notifications: contact form, fee reports, health alerts)
MAIL_WORKER_URL=
MAIL_WORKER_TOKEN=

# Operations: bearer for detailed /api/health, IndexNow key
CRON_SECRET=
INDEXNOW_KEY=

# Deploy fallback (optional): GitHub webhook secret and the Vercel Deploy Hook it triggers
GITHUB_WEBHOOK_SECRET=
VERCEL_DEPLOY_HOOK_URL=

# Analytics (FlowGlance public site key and site id)
NEXT_PUBLIC_FLOWGLANCE_KEY=
FLOWGLANCE_SITE_ID=

# Advertising (optional): Google AdSense publisher id (ca-pub-…) and the calculator-page slot id
NEXT_PUBLIC_ADSENSE_CLIENT=
NEXT_PUBLIC_ADSENSE_SLOT_CALC=
